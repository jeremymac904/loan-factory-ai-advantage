# Loan Factory AI Advantage — environment variables
#
# Copy this file to `.env.local` for local development.
# `.env.local` is gitignored — never commit real credentials.
#
# All four variables are OPTIONAL during demo mode (the app falls back to
# mock data in src/lib/mock-data.ts). They become REQUIRED once Supabase
# persistence is wired (see docs/SUPABASE_SCHEMA_PLAN.md).

# -----------------------------------------------------------------------------
# Supabase — public (safe to ship to the browser)
# -----------------------------------------------------------------------------

# Your Supabase project URL.
# Find it in: Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Your Supabase anon (public) key.
# Find it in: Supabase dashboard → Project Settings → API → Project API keys → anon public
# This key is paired with Row Level Security — see supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# -----------------------------------------------------------------------------
# Supabase — server-side only (NEVER expose to the browser)
# -----------------------------------------------------------------------------

# Your Supabase service role key. Bypasses RLS — used by admin server routes
# (approve, publish, etc.). Treat as a production secret.
# Find it in: Supabase dashboard → Project Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Canonical public URL for this deployment. Used for absolute URLs in metadata,
# OG tags, and share links on /site/[slug].
# Local dev: http://localhost:3000
# Production: https://aiadvantage.loanfactory.com (or whatever DNS TERA assigns)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AI features — server-side only
# -----------------------------------------------------------------------------
# All of these default to OFF / demo. The platform stays in placeholder mode
# until AI_FEATURES_ENABLED=true AND AI_PROVIDER=minimax AND MiniMax is
# fully configured. See docs/AGENT_SYSTEM_PLAN.md and the TODO checklist in
# src/lib/ai/minimax.ts before flipping anything live.
#
# IMPORTANT: do NOT prefix any of these with NEXT_PUBLIC_. Doing so would
# bake secrets into the browser bundle.

# Which provider to route through. `demo` keeps placeholder responses.
# Set to `minimax` only after Marketing & IT approve and the TODO checklist
# in src/lib/ai/minimax.ts is complete.
AI_PROVIDER=demo

# Master switch. Must be exactly `true` to route to a live provider.
AI_FEATURES_ENABLED=false

# Force AI-generated drafts into the Marketing review queue. Keep this `true`
# for the pilot — Marketing must approve every public asset.
AI_DRAFTS_REQUIRE_REVIEW=true

# Per-task feature flags. Default OFF.
AI_IMAGE_GENERATION_ENABLED=false
AI_VIDEO_PROMPT_GENERATION_ENABLED=false

# Verbose server-side logging. Never logs secrets. Default OFF.
AI_DEBUG_LOGS=false

# -----------------------------------------------------------------------------
# MiniMax — SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix on any of these)
# -----------------------------------------------------------------------------
# Until the official MiniMax docs are confirmed (base URL, endpoint paths,
# auth header format, model IDs, request/response shapes), src/lib/ai/minimax.ts
# does NOT make any real network call. These env vars exist so the provider
# can self-check whether it's "configured" — they do not by themselves enable
# live calls.

# The MiniMax account API key. Mark as ENCRYPTED in Netlify. Never log this.
MINIMAX_API_KEY=

# Base URL for the MiniMax API. VERIFY against official MiniMax docs before
# setting in production. Do not guess.
MINIMAX_BASE_URL=

# Model IDs. VERIFY they exist on the Loan Factory MiniMax account. Do not
# guess from training data — read the dashboard.
MINIMAX_TEXT_MODEL=
MINIMAX_IMAGE_MODEL=
MINIMAX_VIDEO_MODEL=
